# ==============================================================================
# CodeSight-AI Environment Configuration (Host-Isolated Defaults)
# Copy to .env for local runs and Docker Compose. Never commit .env to Git.
# ==============================================================================

# --- Core Application ---
APP_NAME=codesight-ai
APP_ENV=development
LOG_LEVEL=INFO

# --- FastAPI Gateway (FlintFlow=8080, DocuMind=8081) ---
API_HOST=0.0.0.0
API_PORT=8082

# --- PostgreSQL 16 (DocuMind=5432 -> CodeSight=5433) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=codesight
POSTGRES_PASSWORD=codesight_dev_password
POSTGRES_DB=codesight

# --- Redis 7 (FlintFlow=6379, DocuMind=6380 -> CodeSight=6381) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_DB=0
# REDIS_PASSWORD=

# --- Qdrant Vector Store ---
QDRANT_HOST=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Health Check ---
HEALTH_TIMEOUT_SECONDS=1.5

# --- GitHub App & Webhook E2E Integration (see docs/github_app_setup.md) ---
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY=   # Single-line Base64-encoded PEM (recommended) or \n-escaped PEM
# GITHUB_WEBHOOK_SECRET=replace-with-strong-random-hex-secret
# GITHUB_TOKEN=         # Optional PAT fallback for `codesight review --dry-run` on private repos
WEEK1_SMOKE_INLINE_COMMENT=true

# --- Optional Phase 2+ Integrations (Keep commented until needed) ---
# GEMINI_API_KEY=
INDEX_EMBED_CODE_CHUNKS=false
GEMINI_EMBED_TPM_BUDGET=25000
GEMINI_EMBED_CONCURRENCY=2
INDEX_TASK_SOFT_TIME_LIMIT_SECONDS=300
INDEX_TASK_HARD_TIME_LIMIT_SECONDS=360

# --- Multi-Agent LangGraph LLM & Langfuse Cloud Tracing (Sprint 3) ---
# LLM_PROVIDER supports: gemini (default), openai, anthropic
LLM_PROVIDER=gemini
AUDITOR_MODEL=gemini-2.5-flash
# CRITIC_MODEL supports: gemini-2.5-flash (Free Tier default) or gemini-2.5-pro
CRITIC_MODEL=gemini-2.5-flash
LLM_MAX_CONCURRENCY=3
# Optional non-Gemini provider API keys (used when LLM_PROVIDER is 'openai' or 'anthropic')
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Enable Langfuse Cloud tracing by setting LANGFUSE_TRACING_ENABLED=true and both API keys below.
# Raw prompts, diffs, code snippets, and secrets are masked before export (NFR-3).
LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional Milestone 2 Live Evaluation Overrides ---
# CODESIGHT_LIVE_PY_REPO=Tieens-04/CodeSight-AI
# CODESIGHT_LIVE_TS_REPO=
# CODESIGHT_QDRANT_CONTAINER=codesight-qdrant
